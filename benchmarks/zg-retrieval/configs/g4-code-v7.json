{
  "id": "zg-code-graph-l1-l2-v7",
  "schema_version": 7,
  "inputs": "data/g4-code-v1.json",
  "model": "local/potion-code-16m-v2",
  "device": "cpu",
  "retrieval": "hybrid",
  "graph_modes": ["off", "augment", "constrain"],
  "limit": 10,
  "repetitions": 5,
  "quality_repetition": 5,
  "request": {
    "autoUpdate": false,
    "freshness": "eventual",
    "preferSymbol": false
  },
  "execution": { "request_timeout_ms": 30000, "graph_timeout_ms": 5000 },
